{
  "name": "eastpeaks",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "astro build",
    "check": "wrangler types && astro check && tsc --noEmit",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "pipeline": "docker compose -f pipeline/compose.yaml run --rm pipeline",
    "tiles:upload": "node scripts/upload-tiles.mjs",
    "prices": "node --env-file-if-exists=.env scripts/fetch-prices.ts",
    "prebuild": "npm run prices",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/preact": "^6.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "maplibre-gl": "^6.19.0",
    "pmtiles": "^4.5.0",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^5.9.3",
    "wrangler": "^4.165.0"
  }
}
