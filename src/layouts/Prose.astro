---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  kicker?: string;
}

const { kicker = 'EastPeaks', ...props } = Astro.props;
---

<Base {...props}>
  <article class="container-site section">
    <div class="prose-ed">
      <p class="label text-gold-deep">{kicker}</p>
      <h1 class="mt-4">{props.title}</h1>
      <slot />
    </div>
  </article>
</Base>
