---
import { getCollection } from 'astro:content';
import ResortCard from '../components/resort/ResortCard.astro';
import { SITE } from '../data/site';
import Base from '../layouts/Base.astro';
import { getResorts } from '../lib/resorts';

const resorts = await getResorts();
const pairs = (await getCollection('comparatii'))
  .map(({ data }) => ({ a: resorts.find((r) => r.slug === data.a), b: resorts.find((r) => r.slug === data.b) }))
  .filter((p) => p.a && p.b);
---

<Base
  title={SITE.name}
  description="Hărți ale pârtiilor, prețuri la skipass, distanțe cu mașina și un calculator de cost pentru stațiunile de schi din România, Balcani și Austria."
>
  <section class="bg-brand text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <h1 class="max-w-3xl text-3xl font-bold tracking-tight text-balance sm:text-5xl">Unde mergi la schi iarna asta?</h1>
      <p class="mt-4 max-w-2xl text-lg text-brand-soft">
        Comparăm stațiunile din România, Balcani și Austria pe date: kilometri de pârtie, pante, prețul skipass-ului și
        cât faci cu mașina din București, Cluj sau Brașov.
      </p>
      <a
        href="/statiuni/"
        class="mt-8 inline-block rounded-lg bg-white px-5 py-3 font-semibold text-brand no-underline hover:bg-brand-soft hover:no-underline"
      >
        Vezi stațiunile
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="text-2xl font-semibold tracking-tight">Stațiuni</h2>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        resorts.map((r) => (
          <li>
            <ResortCard resort={r} />
          </li>
        ))
      }
    </ul>

    {
      pairs.length > 0 && (
        <>
          <h2 class="mt-12 text-2xl font-semibold tracking-tight">Comparații</h2>
          <ul class="mt-4 space-y-2">
            {pairs.map(({ a, b }) => (
              <li>
                <a href={`/compara/${a!.slug}-vs-${b!.slug}/`}>
                  {a!.name} sau {b!.name}?
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Base>
