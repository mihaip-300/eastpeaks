---
import Base from '../layouts/Base.astro';
---

<Base title="Pagina nu există" description="Pagina căutată nu există." noindex>
  <div class="container-site section text-center">
    <p class="label text-gold-deep">404</p>
    <h1 class="mx-auto mt-4 max-w-3xl text-h1">Aici nu e nicio pârtie.</h1>
    <p class="mx-auto mt-5 max-w-text text-lead text-slate">Pagina a fost mutată sau adresa are o greșeală.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-dark">Pagina principală</a>
      <a href="/statiuni/" class="btn btn-outline">Toate stațiunile</a>
    </div>
  </div>
</Base>
