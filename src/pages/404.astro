---
import Base from '../layouts/Base.astro';
---

<Base title="Pagina nu există" description="Pagina căutată nu există." noindex>
  <div class="mx-auto max-w-6xl px-4 py-20 text-center">
    <p class="text-sm font-semibold text-accent">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Pagina nu există</h1>
    <p class="mt-3 text-muted">Poate a fost mutată sau adresa are o greșeală.</p>
    <p class="mt-8">
      <a href="/" class="font-semibold">Înapoi la pagina principală</a> · <a href="/statiuni/" class="font-semibold"
        >Toate stațiunile</a
      >
    </p>
  </div>
</Base>
