---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { COUNTRIES } from '../../data/countries';
import Base from '../../layouts/Base.astro';
import { formatEur, formatKm, formatMeters } from '../../lib/format';
import { getResorts } from '../../lib/resorts';

const resorts = await getResorts();
const countriesWithResorts = COUNTRIES.filter((c) => resorts.some((r) => r.country.slug === c.slug));
---

<Base
  title="Toate stațiunile de schi"
  description="Stațiunile de schi din România, Balcani și Austria comparate pe kilometri de pârtie, altitudine și prețul skipass-ului."
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumbs crumbs={[{ name: 'Stațiuni', url: '/statiuni/' }]} />
    <h1 class="mt-2 text-3xl font-bold tracking-tight">Toate stațiunile</h1>
    <p class="mt-3 max-w-2xl text-muted">
      Începem cu {resorts.length} stațiuni; lista crește înainte de sezon. Kilometrii vin din OpenStreetMap, prețurile de
      pe site-urile oficiale.
    </p>
    <p class="mt-3 text-sm">
      Pe țări:{' '}
      {
        countriesWithResorts.map((c, i) => (
          <>
            {i > 0 && ' · '}
            <a href={`/statiuni/${c.slug}/`}>{c.name}</a>
          </>
        ))
      }
    </p>

    <div class="-mx-4 mt-6 overflow-x-auto px-4">
      <table class="w-full min-w-[40rem] text-sm">
        <thead>
          <tr class="border-b border-line text-left text-muted">
            <th class="py-2 pr-3 font-medium">Stațiune</th>
            <th class="py-2 pr-3 font-medium">Țară</th>
            <th class="py-2 pr-3 text-right font-medium">Pârtii</th>
            <th class="py-2 pr-3 text-right font-medium">Altitudine</th>
            <th class="py-2 pr-3 text-right font-medium">Lifturi</th>
            <th class="py-2 text-right font-medium">Skipass adult, 1 zi</th>
          </tr>
        </thead>
        <tbody>
          {
            resorts.map((r) => (
              <tr class="border-b border-line">
                <td class="py-2.5 pr-3 font-medium">
                  <a href={r.url}>{r.name}</a>
                </td>
                <td class="py-2.5 pr-3">{r.country.name}</td>
                <td class="py-2.5 pr-3 text-right tabular-nums">{formatKm(r.generated.runs.km_total)}</td>
                <td class="py-2.5 pr-3 text-right tabular-nums">
                  {formatMeters(r.generated.elevation_m.min)}–{formatMeters(r.generated.elevation_m.max)}
                </td>
                <td class="py-2.5 pr-3 text-right tabular-nums">{r.generated.lifts.count}</td>
                <td class="py-2.5 text-right tabular-nums">
                  {r.priceEur?.adult_1d != null ? `≈ ${formatEur(r.priceEur.adult_1d)}` : <span class="text-muted">nedisponibil</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</Base>
