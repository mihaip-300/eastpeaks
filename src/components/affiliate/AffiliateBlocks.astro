---
// Stay / Rent / Transfer blocks (HANDOFF 8.4). A block only appears when a partner
// actually covers the resort; links go through AffiliateLink (/go/).
import { hasTarget } from '../../data/partners';
import type { Resort } from '../../lib/resorts';
import AffiliateLink from './AffiliateLink.astro';

interface Props {
  resort: Resort;
}

const { resort } = Astro.props;
const p = resort.editorial?.partners;
const airports = resort.editorial?.airports ?? [];

const stay = hasTarget('booking', p?.booking) ? p!.booking : null;
const rentals = [
  { partner: 'skiset' as const, name: 'Skiset', target: p?.skiset },
  { partner: 'snowrental' as const, name: 'Snowrental', target: p?.snowrental },
].filter((r): r is { partner: 'skiset' | 'snowrental'; name: string; target: string } => hasTarget(r.partner, r.target));
const cars = (p?.car ?? [])
  .filter((code) => hasTarget('car', code))
  .map((code) => ({ code, airport: airports.find((a) => a.iata.toLowerCase() === code) }));

const button =
  'mt-4 inline-block rounded-lg bg-brand px-4 py-2.5 text-center font-semibold text-white no-underline hover:bg-ink hover:no-underline';
const secondary =
  'inline-block rounded-lg border border-line px-3 py-2 text-sm font-medium text-ink no-underline hover:border-accent hover:no-underline';
const any = stay || rentals.length || cars.length;
---

{
  any && (
    <div class="grid gap-4 md:grid-cols-3">
      {stay && (
        <div class="flex flex-col rounded-xl border border-line p-5">
          <h3 class="font-semibold">Cazare</h3>
          <p class="mt-1 flex-1 text-sm text-muted">Hoteluri, pensiuni și apartamente în {resort.name} și împrejurimi.</p>
          <AffiliateLink partner="booking" target={stay} from={resort.slug} class={button}>
            Vezi cazări pe Booking
          </AffiliateLink>
        </div>
      )}
      {rentals.length > 0 && (
        <div class="flex flex-col rounded-xl border border-line p-5">
          <h3 class="font-semibold">Închiriere echipament</h3>
          <p class="mt-1 flex-1 text-sm text-muted">
            Schiuri, clăpari și snowboard rezervate online, cu reducere față de prețul din magazin.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {rentals.map((r) => (
              <AffiliateLink partner={r.partner} target={r.target} from={resort.slug} class={secondary}>
                {r.name}
              </AffiliateLink>
            ))}
          </div>
        </div>
      )}
      {cars.length > 0 && (
        <div class="flex flex-col rounded-xl border border-line p-5">
          <h3 class="font-semibold">Mașină de la aeroport</h3>
          <p class="mt-1 flex-1 text-sm text-muted">Dacă vii cu avionul, compară ofertele de închiriere de la aeroport.</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {cars.map((c) => (
              <AffiliateLink partner="car" target={c.code} from={resort.slug} class={secondary}>
                {c.airport ? c.airport.name : c.code.toUpperCase()}
              </AffiliateLink>
            ))}
          </div>
        </div>
      )}
    </div>
  )
}
{
  any && (
    <p class="mt-3 text-xs text-muted">
      Linkuri de afiliere: dacă rezervi prin ele, primim un comision, fără cost în plus pentru tine.{' '}
      <a href="/afiliere/">Cum funcționează</a>.
    </p>
  )
}
