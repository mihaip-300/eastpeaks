---
// FAQ accordion on native <details>: keyboard accessible, no JavaScript.
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-stone border-y border-stone">
  {
    items.map((item) => (
      <details class="faq group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg">
          <span class="font-display text-[1.375rem] leading-snug">{item.q}</span>
          <span class="faq-icon relative h-4 w-4 shrink-0 text-gold-deep" aria-hidden="true" />
        </summary>
        <p class="max-w-text pb-6 text-slate">{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1px;
    background: currentColor;
    transition: transform 300ms var(--ease-out-soft);
  }
  .faq-icon::after {
    transform: rotate(90deg);
  }
  .faq[open] .faq-icon::after {
    transform: rotate(0deg);
  }
</style>
