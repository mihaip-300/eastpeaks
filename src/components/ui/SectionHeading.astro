---
interface Props {
  kicker: string;
  title: string;
  id?: string;
  tone?: 'light' | 'dark';
  class?: string;
}

const { kicker, title, id, tone = 'light', class: cls = '' } = Astro.props;
const dark = tone === 'dark';
---

<div class={cls} data-reveal>
  <p class:list={['label', dark ? 'text-gold' : 'text-gold-deep']}>{kicker}</p>
  <h2 id={id} class:list={['mt-4 text-h2', dark ? 'text-ivory' : 'text-midnight']}>{title}</h2>
  {
    Astro.slots.has('default') && (
      <div class:list={['mt-5 max-w-text text-lead', dark ? 'text-mist' : 'text-slate']}>
        <slot />
      </div>
    )
  }
</div>
