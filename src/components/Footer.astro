---
import { FOOTER_LINKS, NAV, SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="on-dark bg-black text-ivory">
  <div class="container-site pt-20 pb-10 sm:pt-28">
    <p class="font-display text-h2 max-w-3xl">Ne vedem pe pârtie.</p>

    <div class="mt-14 grid gap-4 lg:grid-cols-[1.4fr_1fr_1fr]">
      <!-- Newsletter: connected once the Kit form ID exists; until then it says so -->
      <div class="rounded-lg bg-midnight p-6 sm:p-8">
        <p class="label">Newsletter</p>
        <p class="mt-3 text-mist">O scrisoare pe lună în sezon: zăpadă, prețuri noi și ce merită schiat.</p>
        <form class="mt-5 flex flex-col gap-3 sm:flex-row" aria-describedby="newsletter-status" onsubmit="return false">
          <label for="newsletter-email" class="sr-only">Adresa de e-mail</label>
          <input
            id="newsletter-email"
            type="email"
            placeholder="adresa@email.ro"
            disabled
            class="min-w-0 flex-1 rounded-sm border border-gold/30 bg-transparent px-4 py-3 text-ivory placeholder:text-mist/70 disabled:opacity-60"
          />
          <button type="submit" disabled class="btn btn-outline disabled:cursor-not-allowed disabled:opacity-60">Abonează-te</button>
        </form>
        <p id="newsletter-status" class="mt-3 text-sm text-mist">Înscrierile se deschid în curând.</p>
      </div>

      <div class="rounded-lg bg-midnight p-6 sm:p-8">
        <p class="label">Explorează</p>
        <ul class="mt-4 space-y-2.5">
          {NAV.map((l) => <li><a href={l.href} class="link-quiet text-ivory">{l.label}</a></li>)}
        </ul>
      </div>

      <div class="rounded-lg bg-midnight p-6 sm:p-8">
        <p class="label">Despre</p>
        <ul class="mt-4 space-y-2.5">
          {FOOTER_LINKS.map((l) => <li><a href={l.href} class="link-quiet text-ivory">{l.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="mt-14 grid gap-6 border-t border-gold/25 pt-8 text-sm text-mist md:grid-cols-[auto_1fr_auto] md:items-center">
      <img src="/logo.svg" alt="EastPeaks" width="148" height="24" class="h-6 w-auto" loading="lazy" />
      <p class="max-w-2xl md:justify-self-center md:text-center">
        Unele linkuri sunt de afiliere: dacă rezervi prin ele, primim un comision, fără cost în plus pentru tine.
        <a href="/afiliere/" class="text-ivory">Cum funcționează</a>. Hărți © contribuitorii
        <a href="https://www.openstreetmap.org/copyright" class="text-ivory">OpenStreetMap</a>.
      </p>
      <p class="flex items-center gap-4 md:justify-self-end">
        <span class="text-ivory">Română</span>
        <span aria-hidden="true" class="h-3 w-px bg-gold/40"></span>
        <span title="În curând">English</span>
      </p>
    </div>
    <p class="mt-8 text-xs text-mist/80">© {year} {SITE.name}</p>
  </div>
</footer>
