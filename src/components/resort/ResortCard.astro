---
import { formatKm, formatMeters } from '../../lib/format';
import type { Resort } from '../../lib/resorts';

interface Props {
  resort: Resort;
}

const { resort } = Astro.props;
const g = resort.generated;
---

<a
  href={resort.url}
  class="group block overflow-hidden rounded-xl border border-line text-ink no-underline transition hover:border-accent hover:no-underline"
>
  <img
    src={`/maps/${resort.slug}.webp`}
    alt={`Harta pârtiilor din ${resort.name}`}
    width="800"
    height="500"
    loading="lazy"
    decoding="async"
    class="aspect-[8/5] w-full object-cover"
  />
  <div class="p-4">
    <p class="text-lg font-semibold group-hover:text-accent">{resort.name}</p>
    <p class="text-sm text-muted">{resort.editorial?.region ? `${resort.editorial.region}, ` : ''}{resort.country.name}</p>
    <p class="mt-2 text-sm tabular-nums">
      {formatKm(g.runs.km_total)} · {g.lifts.count} lifturi · {formatMeters(g.elevation_m.min)}–{formatMeters(g.elevation_m.max)}
    </p>
  </div>
</a>
