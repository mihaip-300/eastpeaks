---
// Skipass prices on the dark "Costuri" section: local currency + converted value, season, source.
import { RON_PER_EUR } from '../../data/constants';
import { formatDate, formatEur, formatInt, formatLei } from '../../lib/format';
import type { Resort } from '../../lib/resorts';

interface Props {
  resort: Resort;
}

const { resort } = Astro.props;
const p = resort.price;
const eur = resort.priceEur;

const rows = p
  ? ([
      ['Adult, 1 zi', p.adult_1d, eur?.adult_1d],
      ['Adult, 6 zile', p.adult_6d, eur?.adult_6d],
      ['Copil, 1 zi', p.child_1d, eur?.child_1d],
      ['Copil, 6 zile', p.child_6d, eur?.child_6d],
    ] as const)
  : [];
const hasAny = rows.some(([, v]) => v != null);

function local(value: number, currency: string): string {
  if (currency === 'RON') return formatLei(value);
  if (currency === 'EUR') return formatEur(value);
  return `${formatInt(value)} ${currency}`;
}
function converted(value: number, inEur: number | null | undefined, currency: string): string {
  if (currency === 'EUR') return `≈ ${formatLei(value * RON_PER_EUR)}`;
  return inEur != null ? `≈ ${formatEur(inEur)}` : '';
}
---

<div>
  {
    !p || !hasAny ? (
      <div class="rounded-lg bg-midnight p-6">
        <p class="font-display text-h3 text-ivory">Prețurile pe zi apar în curând.</p>
        {p?.note && <p class="mt-3 text-sm text-mist">{p.note}</p>}
      </div>
    ) : (
      <dl class="divide-y divide-gold/15 border-y border-gold/25">
        {rows.map(([label, value, inEur]) => (
          <div class="flex items-baseline justify-between gap-4 py-3.5">
            <dt class="text-mist">{label}</dt>
            <dd class="tabular text-right">
              {value == null ? (
                <span class="text-mist">nedisponibil</span>
              ) : (
                <>
                  <span class="font-display text-2xl text-gold">{local(value, p.currency)}</span>
                  <span class="ml-3 text-sm text-mist">{converted(value, inEur, p.currency)}</span>
                </>
              )}
            </dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    p && (
      <p class="mt-4 text-xs leading-relaxed text-mist">
        {p.season && <>Sezonul {p.season}. </>}
        {hasAny && p.note && <>{p.note} </>}
        Sursa:{' '}
        <a href={p.source_url} rel="noopener" target="_blank" class="text-ivory">
          site-ul oficial
        </a>
        , verificat la {formatDate(p.checked_at)}.
      </p>
    )
  }
</div>
