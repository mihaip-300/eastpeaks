---
import { RON_PER_EUR } from '../../data/constants';
import { formatDate, formatEur, formatInt, formatLei } from '../../lib/format';
import type { Resort } from '../../lib/resorts';

interface Props {
  resort: Resort;
}

const { resort } = Astro.props;
const p = resort.price;
const eur = resort.priceEur;

const rows = p
  ? ([
      ['Adult, 1 zi', p.adult_1d, eur?.adult_1d],
      ['Adult, 6 zile', p.adult_6d, eur?.adult_6d],
      ['Copil, 1 zi', p.child_1d, eur?.child_1d],
      ['Copil, 6 zile', p.child_6d, eur?.child_6d],
    ] as const)
  : [];
const hasAny = rows.some(([, v]) => v != null);

function local(value: number, currency: string): string {
  if (currency === 'RON') return formatLei(value);
  if (currency === 'EUR') return formatEur(value);
  return `${formatInt(value)} ${currency}`;
}
const checked = p ? formatDate(p.checked_at) : '';
---

<div class="rounded-xl border border-line p-4 sm:p-5">
  {
    !p || !hasAny ? (
      <p class="text-muted">
        Prețurile pe zi nu sunt încă disponibile.
        {p?.note && <span class="block mt-1 text-sm">{p.note}</span>}
      </p>
    ) : (
      <table class="w-full text-sm">
        <tbody>
          {rows.map(([label, value, inEur]) => (
            <tr class="border-b border-line last:border-0">
              <th scope="row" class="py-2 pr-3 text-left font-normal">
                {label}
              </th>
              <td class="py-2 text-right font-semibold tabular-nums">{value == null ? <span class="font-normal text-muted">nedisponibil</span> : local(value, p.currency)}</td>
              <td class="w-24 py-2 text-right text-muted tabular-nums">
                {value != null && p.currency !== 'EUR' && inEur != null ? `≈ ${formatEur(inEur)}` : value != null && p.currency === 'EUR' ? `≈ ${formatLei(value * RON_PER_EUR)}` : ''}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }
  {
    p && (
      <p class="mt-3 text-xs text-muted">
        {p.season && <>Sezonul {p.season}. </>}
        {hasAny && p.note && <>{p.note} </>}
        Sursa: <a href={p.source_url} rel="noopener" target="_blank">site-ul oficial</a>, verificat la {checked}.
      </p>
    )
  }
</div>
