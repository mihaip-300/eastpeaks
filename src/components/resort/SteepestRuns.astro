---
import { DIFFICULTIES, DIFFICULTY_LABEL } from '../../data/pistes';
import { formatMeters, formatPct } from '../../lib/format';
import type { SteepestRun } from '../../lib/generated';

interface Props {
  runs: SteepestRun[];
}

const { runs } = Astro.props;
const color = (d: string) => DIFFICULTIES.find((x) => x.key === d)?.color ?? '#8a8a8a';
const th = 'label py-3 pr-4 font-medium text-gold-deep';
---

{
  runs.length === 0 ? (
    <p class="text-slate">În curând.</p>
  ) : (
    <div class="-mx-5 overflow-x-auto px-5 sm:mx-0 sm:px-0">
      <table class="w-full min-w-[40rem]">
        <thead>
          <tr class="border-b border-stone text-left">
            <th class={th}>Pârtie</th>
            <th class={th}>Dificultate</th>
            <th class={`${th} text-right`}>Lungime</th>
            <th class={`${th} text-right`}>Diferență</th>
            <th class={`${th} text-right`}>Pantă medie</th>
            <th class={`${th} !pr-0 text-right`}>Pantă max.</th>
          </tr>
        </thead>
        <tbody>
          {runs.map((r) => (
            <tr class="border-b border-stone">
              <td class="py-4 pr-4">
                <span class="font-display text-xl">{r.name ?? <span class="text-slate">fără nume</span>}</span>
                {r.name_local && (
                  <span class="block text-xs text-slate" lang="bg">
                    {r.name_local}
                  </span>
                )}
              </td>
              <td class="py-4 pr-4 text-sm">
                <span class="inline-flex items-center gap-2">
                  <span class="inline-block h-2 w-2 rounded-full" style={{ background: color(r.difficulty) }} />
                  {DIFFICULTY_LABEL[r.difficulty]}
                </span>
              </td>
              <td class="tabular py-4 pr-4 text-right">{formatMeters(r.length_m)}</td>
              <td class="tabular py-4 pr-4 text-right">{formatMeters(r.drop_m)}</td>
              <td class="tabular py-4 pr-4 text-right">{formatPct(r.avg_gradient_pct)}</td>
              <td class="tabular py-4 text-right font-display text-xl">{formatPct(r.max_gradient_100m_pct)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
