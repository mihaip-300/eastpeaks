---
import { DIFFICULTIES, DIFFICULTY_LABEL } from '../../data/pistes';
import { formatMeters, formatPct } from '../../lib/format';
import type { SteepestRun } from '../../lib/generated';

interface Props {
  runs: SteepestRun[];
}

const { runs } = Astro.props;
const color = (d: string) => DIFFICULTIES.find((x) => x.key === d)?.color ?? '#8a8a8a';
---

{
  runs.length === 0 ? (
    <p class="text-muted">În curând.</p>
  ) : (
    <div class="-mx-4 overflow-x-auto px-4">
      <table class="w-full min-w-[34rem] text-sm">
        <thead>
          <tr class="border-b border-line text-left text-muted">
            <th class="py-2 pr-3 font-medium">Pârtie</th>
            <th class="py-2 pr-3 font-medium">Dificultate</th>
            <th class="py-2 pr-3 text-right font-medium">Lungime</th>
            <th class="py-2 pr-3 text-right font-medium">Diferență de nivel</th>
            <th class="py-2 pr-3 text-right font-medium">Pantă medie</th>
            <th class="py-2 text-right font-medium">Pantă max. (100 m)</th>
          </tr>
        </thead>
        <tbody>
          {runs.map((r) => (
            <tr class="border-b border-line last:border-0">
              <td class="py-2 pr-3">
                {r.name ?? <span class="text-muted">fără nume</span>}
                {r.name_local && <span class="block text-xs text-muted" lang="bg">{r.name_local}</span>}
              </td>
              <td class="py-2 pr-3">
                <span class="inline-flex items-center gap-1.5">
                  <span class="inline-block h-2.5 w-2.5 rounded-full" style={{ background: color(r.difficulty) }} />
                  {DIFFICULTY_LABEL[r.difficulty]}
                </span>
              </td>
              <td class="py-2 pr-3 text-right tabular-nums">{formatMeters(r.length_m)}</td>
              <td class="py-2 pr-3 text-right tabular-nums">{formatMeters(r.drop_m)}</td>
              <td class="py-2 pr-3 text-right tabular-nums">{formatPct(r.avg_gradient_pct)}</td>
              <td class="py-2 text-right font-semibold tabular-nums">{formatPct(r.max_gradient_100m_pct)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
