---
import { DIFFICULTIES } from '../../data/pistes';
import type { GeneratedResort } from '../../lib/generated';

interface Props {
  generated: GeneratedResort;
}

const { generated } = Astro.props;
const total = generated.runs.km_total || 1;
const rows = DIFFICULTIES.map((d) => ({ ...d, km: generated.runs.km_by_difficulty[d.key] ?? 0 })).filter((d) => d.km > 0);
const fmt = (n: number) => n.toLocaleString('ro-RO', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
---

<div>
  <div class="flex h-1.5 overflow-hidden rounded-full bg-stone" role="img" aria-label="Kilometri de pârtie pe dificultate">
    {rows.map((r) => <span style={{ width: `${(r.km / total) * 100}%`, background: r.color }} />)}
  </div>
  <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-4">
    {
      rows.map((r) => (
        <div class="border-t-2 pt-4" style={{ borderColor: r.color }}>
          <dt class="label text-slate">{r.label}</dt>
          <dd class="tabular mt-3 flex items-baseline gap-1.5">
            <span class="font-display text-[2.5rem] leading-none">{fmt(r.km)}</span>
            <span class="text-sm text-slate">km</span>
          </dd>
          <dd class="mt-1 text-sm text-slate">{Math.round((r.km / total) * 100)}% din total</dd>
        </div>
      ))
    }
  </dl>
</div>
