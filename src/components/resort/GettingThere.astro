---
import { formatEur, formatInt } from '../../lib/format';
import type { Editorial } from '../../lib/resorts';

interface Props {
  editorial: Editorial;
}

const { editorial } = Astro.props;
const CITY_LABEL = { bucuresti: 'București', cluj: 'Cluj-Napoca', brasov: 'Brașov' } as const;
const drives = (Object.keys(CITY_LABEL) as (keyof typeof CITY_LABEL)[]).flatMap((k) => {
  const d = editorial.drive[k];
  return d ? [{ city: CITY_LABEL[k], ...d }] : [];
});

function hours(h: number): string {
  const whole = Math.floor(h);
  const min = Math.round(((h - whole) * 60) / 15) * 15;
  const [hh, mm] = min === 60 ? [whole + 1, 0] : [whole, min];
  return hh === 0 ? `${mm} min` : mm === 0 ? `${hh} h` : `${hh} h ${mm} min`;
}
const th = 'label py-3 pr-4 font-medium text-gold-deep';
---

<div class="grid gap-12 sm:grid-cols-2">
  <div>
    <h3 class="text-h3">Cu mașina</h3>
    <table class="mt-5 w-full">
      <thead>
        <tr class="border-b border-stone text-left">
          <th class={th}>Din</th>
          <th class={`${th} text-right`}>Distanță</th>
          <th class={`${th} text-right`}>Timp</th>
          <th class={`${th} !pr-0 text-right`}>Taxe*</th>
        </tr>
      </thead>
      <tbody>
        {
          drives.map((d) => (
            <tr class="border-b border-stone">
              <td class="py-3.5 pr-4">{d.city}</td>
              <td class="tabular py-3.5 pr-4 text-right whitespace-nowrap">{formatInt(d.km)} km</td>
              <td class="tabular py-3.5 pr-4 text-right whitespace-nowrap">~{hours(d.hours)}</td>
              <td class="tabular py-3.5 text-right">{d.road_costs_eur ? formatEur(d.road_costs_eur) : '–'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="mt-3 text-xs text-slate">* Dus-întors, pentru o mașină. Timpii sunt fără trafic și opriri; iarna, socotește mai mult.</p>
  </div>
  <div>
    <h3 class="text-h3">Cu avionul</h3>
    <ul class="mt-5 border-t border-stone">
      {
        editorial.airports.map((a) => (
          <li class="flex items-baseline justify-between gap-3 border-b border-stone py-3.5">
            <span>
              {a.name} <span class="label ml-1 text-gold-deep">{a.iata}</span>
            </span>
            <span class="tabular text-slate">{formatInt(a.km)} km</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>
