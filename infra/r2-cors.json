{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://eastpeaks.eu",
          "https://www.eastpeaks.eu",
          "https://eastpeaks.mihai-prajeu.workers.dev",
          "http://localhost:4321",
          "http://localhost:8787",
          "http://127.0.0.1:8787"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "range",
          "if-match"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Range",
        "Content-Length",
        "Accept-Ranges"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
